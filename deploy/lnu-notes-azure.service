
[Unit]
Description=lnu-notes Azure application
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/lnu-notes.env
WorkingDirectory=/opt/lnu-notes

ExecStart=/opt/lnu-notes/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 app_azure:app

Restart=on-failure
RestartSec=3

User=www-data
Group=www-data
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
